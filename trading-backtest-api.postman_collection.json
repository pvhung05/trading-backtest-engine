							"raw": "{{base_url}}/api/market/watchlist?limit=20",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market",
								"watchlist"
							],
							"query": [
								{
									"key": "limit",
									"value": "20"
								}
							]
