					}
				},
				{
					"name": "Filter Watchlist by Quote Asset",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/market/watchlist/filter?quoteAsset=USDT",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market",
								"watchlist",
								"filter"
							],
							"query": [
								{
									"key": "quoteAsset",
									"value": "USDT"
								}
							]
						}
					}
				},
				{
					"name": "Get Specific Ticker (BTCUSDT)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/market/watchlist/BTCUSDT",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market",
								"watchlist",
								"BTCUSDT"
							]
						}
					}
				},
				{
					"name": "Get Historical Klines (Candlesticks)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/market/klines?symbol=BTCUSDT&interval=1h&limit=100",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market",
								"klines"
							],
							"query": [
								{
									"key": "symbol",
									"value": "BTCUSDT"
								},
								{
									"key": "interval",
									"value": "1h"
								},
								{
									"key": "limit",
									"value": "100"
								}
							]
						}
					}
				},
				{
					"name": "Get Symbol Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/market/symbol/BTCUSDT",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market",
								"symbol",
								"BTCUSDT"
							]
						}
					}
				},
				{
					"name": "Get Market Cache Overview",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/market/cache",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market",
								"cache"
							]
						}
					}
				},
				{
					"name": "Clear Market Cache",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/market/cache",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market",
								"cache"
							]
						}
					}
				}
			]
		},
		{
			"name": "3. Backtest Service",
			"item": [
				{
					"name": "Run Backtest and Save",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"symbol\": \"BTCUSDT\",\n  \"timeframe\": \"1h\",\n  \"startTime\": \"2024-01-01T00:00:00Z\",\n  \"endTime\": \"2024-03-01T00:00:00Z\",\n  \"strategyType\": \"SMA_CROSS\",\n  \"strategyParams\": {\n    \"params\": {\n      \"shortPeriod\": 10,\n      \"longPeriod\": 30\n    }\n  },\n  \"initialCapital\": 10000.0,\n  \"commissionRate\": 0.001,\n  \"slippageRate\": 0.0005,\n  \"positionSizePercent\": 100.0\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/backtest-runs",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"backtest-runs"
							]
						}
					}
				},
				{
					"name": "Get All User Backtest Runs",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/backtest-runs",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"backtest-runs"
							]
						}
					}
				},
				{
					"name": "Get Backtest Run Details by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/backtest-runs/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"backtest-runs",
								"1"
							]
						}
					}
				},
				{
					"name": "Delete Backtest Run by ID",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/backtest-runs/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"backtest-runs",
								"1"
							]
						}
