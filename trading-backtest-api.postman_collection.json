{
	"info": {
		"_postman_id": "trading-backtest-engine-collection",
		"name": "Trading Backtest Engine - Microservices API",
		"description": "Postman collection for Trading Backtest Engine routed through API Gateway (Port 8080).\nServices: Auth (8081), Realtime Market (8082), Backtest Engine (8083).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication Service",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"trader01\",\n  \"email\": \"trader01@gmail.com\",\n  \"password\": \"Password123@\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						}
					}
				},
				{
					"name": "Login (Auto saves token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"auth_token\", jsonData.token);",
									"    console.log(\"Saved auth_token:\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"trader01\",\n  \"password\": \"Password123@\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "Get Current User Profile (/me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Realtime Market Service",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/market/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market",
								"health"
							]
						}
					}
				},
				{
					"name": "Get All Symbols",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/market/symbols",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market",
								"symbols"
							]
						}
					}
				},
				{
					"name": "Search Symbols",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/market/symbols/search?q=BTC",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market",
								"symbols",
								"search"
							],
							"query": [
								{
									"key": "q",
									"value": "BTC"
								}
							]
						}
					}
				},
				{
					"name": "Get Watchlist (Top Tickers)",
					"request": {
						"method": "GET",
