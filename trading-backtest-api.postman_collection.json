				{
					"name": "Load Market Data for Backtest Engine",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/market/load?symbol=BTCUSDT&timeframe=1h&startTime=2024-01-01T00:00:00Z&endTime=2024-02-01T00:00:00Z",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market",
								"load"
							],
							"query": [
								{
									"key": "symbol",
									"value": "BTCUSDT"
								},
								{
									"key": "timeframe",
									"value": "1h"
								},
								{
									"key": "startTime",
									"value": "2024-01-01T00:00:00Z"
								},
								{
									"key": "endTime",
									"value": "2024-02-01T00:00:00Z"
								}
							]
						}
					}
				},
				{
					"name": "Stateless Full Portfolio Simulation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"marketData\": {\n    \"symbol\": \"BTCUSDT\",\n    \"timeframe\": \"1h\",\n    \"startTime\": \"2024-01-01T00:00:00Z\",\n    \"endTime\": \"2024-02-01T00:00:00Z\"\n  },\n  \"strategy\": {\n    \"strategyType\": \"RSI\",\n    \"parameters\": {\n      \"rsiPeriod\": 14,\n      \"oversoldThreshold\": 30.0,\n      \"overboughtThreshold\": 70.0\n    }\n  },\n  \"execution\": {\n    \"commissionRate\": 0.001,\n    \"slippageRate\": 0.0005,\n    \"positionSizePercent\": 100.0\n  },\n  \"capital\": 10000.0\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/portfolio/simulate",
							"host": [
								"{{base_url}}"
